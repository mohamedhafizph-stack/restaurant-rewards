<% if (ads && ads.length > 0) { %>

<section class="ad-section">
  <div class="ad-carousel" id="adCarousel">

    <div class="ad-track" id="adTrack">

      <% ads.forEach((ad, index) => { %>

        <div class="ad-slide">

          <% if (ad.link && ad.link.trim()) { %>

            <a
              href="<%= ad.link %>"
              target="_blank"
              rel="noopener noreferrer"
              class="ad-link"
            >
              <img
                src="<%= ad.imageUrl %>"
                alt="<%= ad.title %>"
                draggable="false"
              >
            </a>

          <% } else { %>

            <img
              src="<%= ad.imageUrl %>"
              alt="<%= ad.title %>"
              draggable="false"
            >

          <% } %>

        </div>

      <% }) %>

    </div>

    <% if (ads.length > 1) { %>

      <button
        class="ad-arrow ad-prev"
        type="button"
        aria-label="Previous advertisement"
      >
        ‹
      </button>

      <button
        class="ad-arrow ad-next"
        type="button"
        aria-label="Next advertisement"
      >
        ›
      </button>

      <div class="ad-dots">

        <% ads.forEach((ad, index) => { %>

          <button
            class="ad-dot <%= index === 0 ? 'active' : '' %>"
            type="button"
            data-index="<%= index %>"
            aria-label="Advertisement <%= index + 1 %>"
          ></button>

        <% }) %>

      </div>

    <% } %>

  </div>
</section>

<style>
  .ad-section {
    width: 100%;
    padding: 10px 14px 4px;
  }

  .ad-carousel {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: #f1f5f9;
    box-shadow: 0 8px 25px rgba(0,0,0,.08);
  }

  .ad-track {
    display: flex;
    width: 100%;
    transition: transform .55s cubic-bezier(.4,0,.2,1);
    touch-action: pan-y;
  }

  .ad-slide {
    flex: 0 0 100%;
    width: 100%;
  }

  .ad-slide img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 6;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  .ad-link {
    display: block;
    width: 100%;
  }

  .ad-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: rgba(0,0,0,.42);
    color: white;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }

  .ad-prev {
    left: 9px;
  }

  .ad-next {
    right: 9px;
  }

  .ad-dots {
    position: absolute;
    left: 50%;
    bottom: 9px;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 20px;
    background: rgba(0,0,0,.3);
  }

  .ad-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,.6);
    cursor: pointer;
    transition: .25s ease;
  }

  .ad-dot.active {
    width: 18px;
    border-radius: 10px;
    background: white;
  }

  @media (min-width: 768px) {
    .ad-section {
      padding: 16px 20px 8px;
    }

    .ad-carousel {
      border-radius: 22px;
    }

    .ad-slide img {
      aspect-ratio: 16 / 5;
    }
  }
</style>

<script>
(function () {

  const carousel =
    document.getElementById('adCarousel');

  if (!carousel) return;

  const track =
    document.getElementById('adTrack');

  const slides =
    carousel.querySelectorAll('.ad-slide');

  const dots =
    carousel.querySelectorAll('.ad-dot');

  const prev =
    carousel.querySelector('.ad-prev');

  const next =
    carousel.querySelector('.ad-next');

  if (slides.length <= 1) return;

  let current = 0;
  let timer = null;

  let touchStartX = 0;
  let touchEndX = 0;

  function showSlide(index) {

    if (index < 0) {
      index = slides.length - 1;
    }

    if (index >= slides.length) {
      index = 0;
    }

    current = index;

    track.style.transform =
      `translateX(-${current * 100}%)`;

    dots.forEach((dot, i) => {
      dot.classList.toggle(
        'active',
        i === current
      );
    });
  }

  function nextSlide() {
    showSlide(current + 1);
  }

  function previousSlide() {
    showSlide(current - 1);
  }

  function startAutoSlide() {

    clearInterval(timer);

    timer = setInterval(
      nextSlide,
      4000
    );
  }

  next?.addEventListener(
    'click',
    () => {
      nextSlide();
      startAutoSlide();
    }
  );

  prev?.addEventListener(
    'click',
    () => {
      previousSlide();
      startAutoSlide();
    }
  );

  dots.forEach(dot => {

    dot.addEventListener(
      'click',
      () => {

        showSlide(
          Number(dot.dataset.index)
        );

        startAutoSlide();
      }
    );

  });

  carousel.addEventListener(
    'touchstart',
    event => {

      touchStartX =
        event.touches[0].clientX;

    },
    { passive: true }
  );

  carousel.addEventListener(
    'touchend',
    event => {

      touchEndX =
        event.changedTouches[0].clientX;

      const distance =
        touchEndX - touchStartX;

      if (Math.abs(distance) < 50) {
        return;
      }

      if (distance < 0) {
        nextSlide();
      } else {
        previousSlide();
      }

      startAutoSlide();

    },
    { passive: true }
  );

  carousel.addEventListener(
    'mouseenter',
    () => clearInterval(timer)
  );

  carousel.addEventListener(
    'mouseleave',
    startAutoSlide
  );

  startAutoSlide();

})();
</script>

<% } %>