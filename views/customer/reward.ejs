<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  >

  <title>Your Reward | <%= settings.name %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >


  <style>

    /* =========================================================
       ROOT
    ========================================================= */

    :root {

      --cream: #f8f8f3;

      --white: #ffffff;

      --sage-light: #e6efe2;

      --sage: #a9c39f;

      --sage-medium: #7f9f76;

      --sage-dark: #547052;

      --olive: #334632;

      --gold: #b59a62;

      --gold-light: #d9c99f;

      --text: #263126;

      --muted: #758075;

      --border: rgba(84,112,82,0.18);

      --shadow:
        0 25px 65px rgba(48,67,48,0.11);

      --soft-shadow:
        0 12px 35px rgba(48,67,48,0.07);

    }


    /* =========================================================
       RESET
    ========================================================= */

    * {

      margin: 0;

      padding: 0;

      box-sizing: border-box;

      -webkit-tap-highlight-color: transparent;

    }


    html {

      scroll-behavior: smooth;

    }


    body {

      min-height: 100vh;

      background:
        radial-gradient(
          circle at 10% 0%,
          rgba(169,195,159,0.20),
          transparent 32%
        ),
        radial-gradient(
          circle at 100% 35%,
          rgba(181,154,98,0.08),
          transparent 28%
        ),
        var(--cream);

      color: var(--text);

      font-family: "DM Sans", sans-serif;

      overflow-x: hidden;

    }


    button,
    input {

      font-family: inherit;

    }


    /* =========================================================
       PAGE
    ========================================================= */

    .page {

      width: 100%;

      max-width: 520px;

      min-height: 100vh;

      margin: 0 auto;

      padding:
        0
        18px
        35px;

      position: relative;

    }


    /* =========================================================
       BACKGROUND DECORATION
    ========================================================= */

    .top-glow {

      position: fixed;

      width: 280px;

      height: 280px;

      border-radius: 50%;

      top: -150px;

      left: 50%;

      transform: translateX(-50%);

      background:
        radial-gradient(
          circle,
          rgba(169,195,159,0.23),
          transparent 70%
        );

      pointer-events: none;

      z-index: -1;

    }


    /* =========================================================
       BRAND
    ========================================================= */

    .brand {

      text-align: center;

      padding-top: 27px;

      padding-bottom: 18px;

      animation:
        fadeDown
        0.75s
        ease
        both;

    }


    .brand-logo {

      width: 105px;

      height: auto;

      display: block;

      margin: 0 auto 10px;

      object-fit: contain;

    }


    .brand-fallback {

      display: none;

      font-family:
        "Cormorant Garamond",
        serif;

      font-size: 33px;

      letter-spacing: 8px;

      font-weight: 600;

      color: var(--sage-dark);

    }


    .brand-line {

      width: 50px;

      height: 1px;

      background: var(--gold);

      margin: 0 auto 9px;

      opacity: 0.75;

    }


    .brand-powered {

      font-size: 8px;

      letter-spacing: 3px;

      text-transform: uppercase;

      color: var(--muted);

    }


    /* =========================================================
       ADVERTISEMENT
    ========================================================= */

    .ad-section {

      margin-bottom: 25px;

      animation:
        fadeUp
        0.75s
        ease
        0.1s
        both;

    }


    .section-label {

      text-align: center;

      font-size: 8px;

      text-transform: uppercase;

      letter-spacing: 3px;

      color: var(--muted);

      margin-bottom: 9px;

    }


    .ad-wrapper {

      border-radius: 16px;

      overflow: hidden;

    }


    /* =========================================================
       HEADER
    ========================================================= */

    .header {

      text-align: center;

      padding:
        3px
        8px
        19px;

      animation:
        fadeUp
        0.8s
        ease
        0.15s
        both;

    }


    .eyebrow {

      font-size: 9px;

      letter-spacing: 3px;

      text-transform: uppercase;

      color: var(--sage-dark);

      font-weight: 600;

      margin-bottom: 7px;

    }


    .title {

      font-family:
        "Cormorant Garamond",
        serif;

      font-size:
        clamp(37px, 10vw, 48px);

      font-weight: 600;

      line-height: 0.95;

      color: var(--olive);

      letter-spacing: -0.5px;

    }


    .subtitle {

      margin:
        10px
        auto
        0;

      max-width: 340px;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.6;

    }


    /* =========================================================
       DIVIDER
    ========================================================= */

    .luxury-divider {

      display: flex;

      align-items: center;

      gap: 10px;

      max-width: 210px;

      margin:
        0
        auto
        23px;

    }


    .luxury-divider span {

      flex: 1;

      height: 1px;

      background:
        linear-gradient(
          90deg,
          transparent,
          var(--gold-light)
        );

    }


    .luxury-divider span:last-child {

      background:
        linear-gradient(
          90deg,
          var(--gold-light),
          transparent
        );

    }


    .luxury-divider i {

      width: 5px;

      height: 5px;

      border:
        1px
        solid
        var(--gold);

      transform:
        rotate(45deg);

    }


    /* =========================================================
       PREMIUM REWARD TICKET
    ========================================================= */

    .reward-ticket {

      position: relative;

      width: 100%;

      min-height: 235px;

      padding:
        30px
        20px
        26px;

      border-radius: 25px;

      overflow: hidden;

      color: white;

      background:
        linear-gradient(
          145deg,
          #344933,
          #526e50 48%,
          #3c5639
        );

      box-shadow:
        0 28px 60px rgba(51,70,50,0.22);

      animation:
        ticketAppear
        0.9s
        cubic-bezier(.2,.8,.2,1)
        0.15s
        both;

    }


    /*
      Outer luxury border
    */

    .reward-ticket::before {

      content: "";

      position: absolute;

      inset: 7px;

      border:
        1px
        solid
        rgba(217,201,159,0.45);

      border-radius: 19px;

      pointer-events: none;

    }


    /*
      Soft glow
    */

    .reward-ticket::after {

      content: "";

      position: absolute;

      width: 220px;

      height: 220px;

      border-radius: 50%;

      right: -120px;

      top: -120px;

      background:
        rgba(255,255,255,0.08);

      pointer-events: none;

    }


    .ticket-top {

      position: relative;

      z-index: 2;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

    }


    .ticket-brand {

      font-size: 8px;

      letter-spacing: 3px;

      text-transform: uppercase;

      color:
        rgba(255,255,255,0.70);

    }


    .ticket-status {

      display: inline-flex;

      align-items: center;

      gap: 6px;

      font-size: 8px;

      letter-spacing: 1.5px;

      text-transform: uppercase;

      color:
        rgba(255,255,255,0.80);

    }


    .status-dot {

      width: 5px;

      height: 5px;

      border-radius: 50%;

      background: #d9e8d2;

      box-shadow:
        0 0 0 4px
        rgba(217,232,210,0.10);

      animation:
        pulse
        2s
        ease
        infinite;

    }


    .ticket-center {

      position: relative;

      z-index: 2;

      text-align: center;

      padding:
        27px
        5px
        22px;

    }


    .ticket-icon {

      width: 46px;

      height: 46px;

      margin:
        0
        auto
        10px;

      display: flex;

      align-items: center;

      justify-content: center;

      border:
        1px
        solid
        rgba(217,201,159,0.55);

      border-radius: 50%;

      font-size: 20px;

      animation:
        float
        3s
        ease-in-out
        infinite;

    }


    .ticket-value {

      font-family:
        "Cormorant Garamond",
        serif;

      font-size:
        clamp(40px, 12vw, 56px);

      line-height: 0.9;

      font-weight: 600;

      letter-spacing: -1px;

      color: white;

      text-shadow:
        0 4px 15px
        rgba(0,0,0,0.10);

    }


    .ticket-caption {

      margin-top: 9px;

      font-size: 9px;

      letter-spacing: 2px;

      text-transform: uppercase;

      color:
        rgba(255,255,255,0.70);

    }


    .ticket-bottom {

      position: relative;

      z-index: 2;

      display: flex;

      align-items: flex-end;

      justify-content: space-between;

      gap: 15px;

      padding-top: 13px;

      border-top:
        1px
        solid
        rgba(255,255,255,0.15);

    }


    .ticket-id-label {

      font-size: 7px;

      text-transform: uppercase;

      letter-spacing: 2px;

      color:
        rgba(255,255,255,0.52);

      margin-bottom: 3px;

    }


    .ticket-id {

      font-size: 9px;

      color:
        rgba(255,255,255,0.80);

      word-break: break-all;

    }


    .ticket-symbol {

      color:
        rgba(217,201,159,0.75);

      font-size: 18px;

    }


    /* =========================================================
       STATUS BOX
    ========================================================= */

    .status-box {

      margin-top: 18px;

      padding:
        17px
        16px;

      border-radius: 16px;

      text-align: center;

      font-size: 11px;

      line-height: 1.65;

      animation:
        fadeUp
        0.65s
        ease
        0.35s
        both;

    }


    .status-box strong {

      font-family:
        "Cormorant Garamond",
        serif;

      font-size: 22px;

      font-weight: 600;

    }


    .status-active {

      background:
        rgba(169,195,159,0.18);

      border:
        1px
        solid
        rgba(127,159,118,0.17);

      color:
        #4e6c4a;

    }


    .status-pending {

      background:
        rgba(181,154,98,0.09);

      border:
        1px
        solid
        rgba(181,154,98,0.18);

      color:
        #806e47;

    }


    .status-paid {

      background:
        rgba(169,195,159,0.18);

      border:
        1px
        solid
        rgba(127,159,118,0.17);

      color:
        #4e6c4a;

    }


    .status-redeemed {

      background:
        rgba(84,112,82,0.08);

      border:
        1px
        solid
        rgba(84,112,82,0.13);

      color:
        #526252;

    }


    .status-expired {

      background:
        rgba(160,90,90,0.07);

      border:
        1px
        solid
        rgba(160,90,90,0.11);

      color:
        #8b6262;

    }


    /* =========================================================
       FORM
    ========================================================= */

    .form-section {

      margin-top: 24px;

      padding:
        23px
        18px;

      border:
        1px
        solid
        var(--border);

      border-radius: 21px;

      background:
        rgba(255,255,255,0.72);

      box-shadow:
        var(--soft-shadow);

      text-align: left;

      animation:
        fadeUp
        0.75s
        ease
        0.4s
        both;

    }


    .form-heading {

      text-align: center;

      margin-bottom: 21px;

    }


    .form-eyebrow {

      font-size: 8px;

      letter-spacing: 2.5px;

      text-transform: uppercase;

      color: var(--sage-dark);

      margin-bottom: 5px;

    }


    .form-title {

      font-family:
        "Cormorant Garamond",
        serif;

      font-size: 27px;

      font-weight: 600;

      color: var(--olive);

    }


    .field {

      margin-bottom: 15px;

    }


    .field:last-of-type {

      margin-bottom: 4px;

    }


    label {

      display: block;

      margin-bottom: 7px;

      font-size: 9px;

      letter-spacing: 1.4px;

      text-transform: uppercase;

      font-weight: 600;

      color: var(--sage-dark);

    }


    input {

      width: 100%;

      height: 48px;

      padding:
        0
        14px;

      border:
        1px
        solid
        rgba(84,112,82,0.18);

      border-radius: 11px;

      background:
        rgba(255,255,255,0.85);

      color: var(--text);

      font-size: 13px;

      outline: none;

      transition:
        border 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;

    }


    input::placeholder {

      color: #a0aaa0;

    }


    input:focus {

      border-color:
        var(--sage-medium);

      background: white;

      box-shadow:
        0 0 0 4px
        rgba(127,159,118,0.09);

    }


    /* =========================================================
       BUTTONS
    ========================================================= */

    .btn {

      width: 100%;

      min-height: 49px;

      border: none;

      border-radius: 999px;

      cursor: pointer;

      font-size: 11px;

      font-weight: 600;

      letter-spacing: 0.4px;

      margin-top: 11px;

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        opacity 0.2s ease;

    }


    .btn:active {

      transform: scale(0.975);

    }


    .btn:disabled {

      opacity: 0.55;

      cursor: not-allowed;

    }


    .btn-primary {

      background:
        var(--olive);

      color: white;

      box-shadow:
        0 12px 26px
        rgba(51,70,50,0.18);

    }


    .btn-location {

      background:
        linear-gradient(
          135deg,
          var(--sage-dark),
          var(--olive)
        );

      color: white;

      box-shadow:
        0 12px 27px
        rgba(51,70,50,0.18);

    }


    /* =========================================================
       REDEMPTION SECTION
    ========================================================= */

    #redeemSection {

      margin-top: 20px;

      animation:
        fadeUp
        0.6s
        ease
        both;

    }


    .redeem-card {

      padding:
        20px
        17px;

      border:
        1px
        solid
        rgba(127,159,118,0.18);

      border-radius: 20px;

      background:
        linear-gradient(
          145deg,
          rgba(255,255,255,0.9),
          rgba(230,239,226,0.55)
        );

      text-align: center;

    }


    .redeem-icon {

      width: 45px;

      height: 45px;

      display: flex;

      align-items: center;

      justify-content: center;

      margin:
        0
        auto
        10px;

      border-radius: 50%;

      border:
        1px
        solid
        rgba(181,154,98,0.45);

      font-size: 19px;

    }


    .redeem-title {

      font-family:
        "Cormorant Garamond",
        serif;

      font-size: 25px;

      color: var(--olive);

      font-weight: 600;

    }


    .redeem-copy {

      margin-top: 5px;

      font-size: 10px;

      color: var(--muted);

      line-height: 1.55;

    }


    /* =========================================================
       LOCATION STATUS
    ========================================================= */

    #locationStatus {

      display: none;

      margin-top: 13px;

      padding:
        11px
        13px;

      border-radius: 11px;

      font-size: 10px;

      line-height: 1.5;

      text-align: center;

    }


    #locationStatus.show {

      display: block;

      animation:
        statusAppear
        0.3s
        ease
        both;

    }


    #locationStatus.info {

      background:
        rgba(169,195,159,0.13);

      color:
        #587154;

      border:
        1px
        solid
        rgba(127,159,118,0.12);

    }


    #locationStatus.success {

      background:
        rgba(169,195,159,0.20);

      color:
        #466543;

      border:
        1px
        solid
        rgba(127,159,118,0.17);

    }


    #locationStatus.error {

      background:
        rgba(160,90,90,0.07);

      color:
        #8b6262;

      border:
        1px
        solid
        rgba(160,90,90,0.10);

    }


    /* =========================================================
       PENDING / PAID DETAIL
    ========================================================= */

    .detail-row {

      display: flex;

      justify-content: space-between;

      gap: 15px;

      padding:
        9px
        0;

      border-bottom:
        1px
        solid
        rgba(84,112,82,0.10);

      text-align: left;

      font-size: 10px;

    }


    .detail-row:last-child {

      border-bottom: none;

    }


    .detail-label {

      color: var(--muted);

    }


    .detail-value {

      color: var(--olive);

      font-weight: 600;

      text-align: right;

      word-break: break-word;

    }


    /* =========================================================
       BACK LINK
    ========================================================= */

    .back-link {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 6px;

      margin-top: 24px;

      color: var(--muted);

      font-size: 10px;

      letter-spacing: 0.3px;

      transition:
        color 0.2s ease;

    }


    .back-link:hover {

      color: var(--sage-dark);

    }


    /* =========================================================
       FOOTER
    ========================================================= */

    .footer {

      text-align: center;

      padding-top: 25px;

      margin-top: 25px;

      border-top:
        1px
        solid
        rgba(84,112,82,0.10);

      animation:
        fadeUp
        0.8s
        ease
        0.5s
        both;

    }


    .footer-small {

      font-size: 8px;

      letter-spacing: 2px;

      text-transform: uppercase;

      color: #9aa49a;

    }


    .footer-brand {

      margin-top: 5px;

      font-family:
        "Cormorant Garamond",
        serif;

      font-size: 20px;

      letter-spacing: 3px;

      color: var(--sage-dark);

    }


    /* =========================================================
       ANIMATIONS
    ========================================================= */

    @keyframes fadeUp {

      from {

        opacity: 0;

        transform:
          translateY(17px);

      }

      to {

        opacity: 1;

        transform:
          translateY(0);

      }

    }


    @keyframes fadeDown {

      from {

        opacity: 0;

        transform:
          translateY(-14px);

      }

      to {

        opacity: 1;

        transform:
          translateY(0);

      }

    }


    @keyframes ticketAppear {

      from {

        opacity: 0;

        transform:
          translateY(22px)
          scale(0.97);

      }

      to {

        opacity: 1;

        transform:
          translateY(0)
          scale(1);

      }

    }


    @keyframes float {

      0%,
      100% {

        transform:
          translateY(0);

      }

      50% {

        transform:
          translateY(-4px);

      }

    }


    @keyframes pulse {

      0%,
      100% {

        box-shadow:
          0 0 0 3px
          rgba(217,232,210,0.10);

      }

      50% {

        box-shadow:
          0 0 0 7px
          rgba(217,232,210,0.03);

      }

    }


    @keyframes statusAppear {

      from {

        opacity: 0;

        transform:
          translateY(7px);

      }

      to {

        opacity: 1;

        transform:
          translateY(0);

      }

    }


    /* =========================================================
       LARGER PHONES
    ========================================================= */

    @media (min-width: 400px) {

      .page {

        padding-left: 22px;

        padding-right: 22px;

      }


      .reward-ticket {

        min-height: 250px;

      }

    }


    /* =========================================================
       DESKTOP
    ========================================================= */

    @media (min-width: 700px) {

      .page {

        max-width: 620px;

        padding-top: 10px;

      }


      .reward-ticket {

        min-height: 265px;

      }


      .ticket-center {

        padding-top: 31px;

        padding-bottom: 25px;

      }

    }

  </style>

</head>


<body>


  <div class="top-glow"></div>


  <main class="page">


    <!-- =====================================================
         BRAND
    ====================================================== -->

    <header class="brand">

      <img
        src="/public/images/ChatGPT Image Sep 22, 2026, 09_08_48 PM.png"
        class="brand-logo"
        alt="Adoraise"
        onerror="this.style.display='none'; document.querySelector('.brand-fallback').style.display='block';"
      >

      <div class="brand-fallback">
        ADORAISE
      </div>

      <div class="brand-line"></div>

      <div class="brand-powered">
        Creative · Digital · Growth
      </div>

    </header>


    <!-- =====================================================
         ADS
    ====================================================== -->

    <% if (typeof ads !== 'undefined' && ads.length > 0) { %>

      <section class="ad-section">

        <div class="section-label">
          Featured
        </div>

        <div class="ad-wrapper">

          <%- include('../partials/adCarousel', { ads: ads }) %>

        </div>

      </section>

    <% } %>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <section class="header">

      <div class="eyebrow">
        Your dining reward
      </div>

      <h1 class="title">
        Congratulations
      </h1>

      <p class="subtitle">
        You've unlocked today's special reward
        from <%= settings.name %>.
      </p>

    </section>


    <div class="luxury-divider">

      <span></span>

      <i></i>

      <span></span>

    </div>


    <!-- =====================================================
         PREMIUM REWARD TICKET
    ====================================================== -->

    <section class="reward-ticket">


      <div class="ticket-top">

        <div class="ticket-brand">
          ADORAISE
        </div>

        <div class="ticket-status">

          <span class="status-dot"></span>

          Reward Ticket

        </div>

      </div>


      <div class="ticket-center">

        <div class="ticket-icon">
          ✦
        </div>

        <div class="ticket-value">
          <%= reward.value %>
        </div>

        <div class="ticket-caption">
          Today's exclusive reward
        </div>

      </div>


      <div class="ticket-bottom">

        <div>

          <div class="ticket-id-label">
            Reward ID
          </div>

          <div class="ticket-id">
            <%= reward.rewardId %>
          </div>

        </div>

        <div class="ticket-symbol">
          ◇
        </div>

      </div>


    </section>


    <!-- =====================================================
         ACTIVE REWARD
    ====================================================== -->

    <% if (reward.status === 'ACTIVE') { %>


      <div class="status-box status-active">

        <strong>
          Your reward is ready
        </strong>

        <br>

        Enter your details below, then verify
        your location to redeem it.

      </div>


      <!-- ===================================================
           CUSTOMER DETAILS
      ==================================================== -->

      <section class="form-section"
        id="customerFormSection"
      >

        <div class="form-heading">

          <div class="form-eyebrow">
            Cashback details
          </div>

          <div class="form-title">
            Where should we send it?
          </div>

        </div>


        <div class="field">

          <label for="customerName">
            Full Name
          </label>

          <input
            type="text"
            id="customerName"
            placeholder="Enter your full name"
            autocomplete="name"
          >

        </div>


        <div class="field">

          <label for="upiId">
            UPI ID / Mobile Number
          </label>

          <input
            type="text"
            id="upiId"
            placeholder="example@upi or mobile number"
            autocomplete="off"
          >

        </div>


        <button
          type="button"
          id="submitUpiBtn"
          class="btn btn-primary"
        >
          Continue
        </button>

      </section>


      <!-- ===================================================
           REDEEM SECTION
      ==================================================== -->

      <section
        id="redeemSection"
        style="display:none;"
      >

        <div class="redeem-card">

          <div class="redeem-icon">
            📍
          </div>

          <div class="redeem-title">
            One final step
          </div>

          <div class="redeem-copy">
            Stay inside the restaurant and verify
            your location to redeem your reward.
          </div>


          <button
            type="button"
            id="redeemBtn"
            class="btn btn-location"
          >
            Verify Location & Redeem
          </button>


          <div
            id="locationStatus"
          ></div>

        </div>

      </section>


    <!-- =====================================================
         PENDING PAYOUT
    ====================================================== -->

    <% } else if (reward.status === 'PENDING_PAYOUT') { %>


      <div class="status-box status-pending">

        <strong>
          Payout Request Submitted
        </strong>

        <br><br>

        Your cashback request has been sent
        to the restaurant.

      </div>


      <div class="form-section">

        <div class="form-heading">

          <div class="form-eyebrow">
            Payout information
          </div>

          <div class="form-title">
            Your details
          </div>

        </div>


        <div class="detail-row">

          <span class="detail-label">
            Name
          </span>

          <span class="detail-value">
            <%= reward.customerName %>
          </span>

        </div>


        <div class="detail-row">

          <span class="detail-label">
            UPI / Mobile
          </span>

          <span class="detail-value">
            <%= reward.upiId %>
          </span>

        </div>


        <div class="status-box status-pending"
          style="margin-top:15px; margin-bottom:0;"
        >

          The restaurant will manually send
          your cashback.

        </div>

      </div>


    <!-- =====================================================
         PAID
    ====================================================== -->

    <% } else if (reward.status === 'PAID') { %>


      <div class="status-box status-paid">

        <strong>
          Cashback Paid
        </strong>

        <br><br>

        Your cashback has been sent successfully.

      </div>


      <div class="form-section">

        <div class="form-heading">

          <div class="form-eyebrow">
            Payment destination
          </div>

          <div class="form-title">
            Payment sent to
          </div>

        </div>


        <div class="detail-row">

          <span class="detail-label">
            UPI / Mobile
          </span>

          <span class="detail-value">
            <%= reward.upiId %>
          </span>

        </div>


        <% if (reward.paidAt) { %>

          <div class="detail-row">

            <span class="detail-label">
              Paid on
            </span>

            <span class="detail-value">
              <%= new Date(reward.paidAt).toLocaleString() %>
            </span>

          </div>

        <% } %>

      </div>


    <!-- =====================================================
         REDEEMED
    ====================================================== -->

    <% } else if (reward.status === 'REDEEMED') { %>


      <div class="status-box status-redeemed">

        <strong>
          Reward Redeemed
        </strong>

        <br><br>

        This reward has already been redeemed.

        <br>

        Thank you for participating!

      </div>


    <!-- =====================================================
         EXPIRED
    ====================================================== -->

    <% } else if (reward.status === 'EXPIRED') { %>


      <div class="status-box status-expired">

        <strong>
          Reward Expired
        </strong>

        <br><br>

        Unfortunately, this reward is no longer
        available.

      </div>


    <!-- =====================================================
         UNKNOWN
    ====================================================== -->

    <% } else { %>


      <div class="status-box status-expired">

        <strong>
          Reward Unavailable
        </strong>

        <br><br>

        This reward cannot currently be redeemed.

      </div>


    <% } %>


    <!-- =====================================================
         BACK
    ====================================================== -->

    <a
      href="/restaurant"
      class="back-link"
    >
      ← Back to restaurant
    </a>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="footer">

      <div class="footer-small">
        Powered by
      </div>

      <div class="footer-brand">
        ADORAISE
      </div>

    </footer>


  </main>


  <!-- =======================================================
       JAVASCRIPT
  ======================================================== -->

  <script>


    const rewardId =
      '<%= reward.rewardId %>';


    /* =======================================================
       SUBMIT UPI DETAILS
    ======================================================== */

    const submitUpiBtn =
      document.getElementById(
        'submitUpiBtn'
      );


    if (submitUpiBtn) {

      submitUpiBtn.addEventListener(
        'click',
        async function () {


          const customerName =
            document
              .getElementById(
                'customerName'
              )
              .value
              .trim();


          const upiId =
            document
              .getElementById(
                'upiId'
              )
              .value
              .trim();


          if (!customerName) {

            alert(
              'Please enter your full name.'
            );

            return;

          }


          if (customerName.length < 2) {

            alert(
              'Please enter a valid name.'
            );

            return;

          }


          if (!upiId) {

            alert(
              'Please enter your UPI ID or mobile number.'
            );

            return;

          }


          submitUpiBtn.disabled =
            true;


          submitUpiBtn.textContent =
            'Submitting...';


          try {


            const response =
              await fetch(
                '/restaurant/submit-upi',
                {

                  method: 'POST',

                  headers: {

                    'Content-Type':
                      'application/json'

                  },

                  body:
                    JSON.stringify({

                      rewardId,

                      customerName,

                      upiId

                    })

                }
              );


            const data =
              await response.json();


            if (
              !response.ok ||
              !data.success
            ) {

              alert(
                data.message ||
                'Unable to submit details.'
              );


              submitUpiBtn.disabled =
                false;


              submitUpiBtn.textContent =
                'Continue';


              return;

            }


            /*
              Hide customer form.
            */

            document
              .getElementById(
                'customerFormSection'
              )
              .style.display =
              'none';


            /*
              Show redemption section.
            */

            document
              .getElementById(
                'redeemSection'
              )
              .style.display =
              'block';


            document
              .getElementById(
                'redeemSection'
              )
              .scrollIntoView({
                behavior: 'smooth',
                block: 'center'
              });


          } catch (error) {


            console.error(
              error
            );


            alert(
              'Server error. Please try again.'
            );


            submitUpiBtn.disabled =
              false;


            submitUpiBtn.textContent =
              'Continue';

          }

        }
      );

    }


    /* =======================================================
       REDEEM BUTTON
    ======================================================== */

    const redeemBtn =
      document.getElementById(
        'redeemBtn'
      );


    const locationStatus =
      document.getElementById(
        'locationStatus'
      );


    if (redeemBtn) {

      redeemBtn.addEventListener(
        'click',
        function () {

          verifyLocation();

        }
      );

    }


    /* =======================================================
       GPS VERIFICATION
    ======================================================== */

    function verifyLocation() {


      if (!navigator.geolocation) {

        showLocationStatus(
          'Your browser does not support location services.',
          'error'
        );

        return;

      }


      redeemBtn.disabled =
        true;


      redeemBtn.textContent =
        'Checking location...';


      showLocationStatus(
        'Getting your current location...',
        'info'
      );


      navigator.geolocation.getCurrentPosition(

        async function (position) {


          const latitude =
            position.coords.latitude;


          const longitude =
            position.coords.longitude;


          showLocationStatus(
            'Location found. Verifying with restaurant...',
            'info'
          );


          try {


            const response =
              await fetch(
                '/restaurant/redeem',
                {

                  method: 'POST',

                  headers: {

                    'Content-Type':
                      'application/json'

                  },

                  body:
                    JSON.stringify({

                      rewardId,

                      latitude,

                      longitude

                    })

                }
              );


            const data =
              await response.json();


            if (
              !response.ok ||
              !data.success
            ) {


              showLocationStatus(
                data.message ||
                'You are not inside the restaurant.',
                'error'
              );


              redeemBtn.disabled =
                false;


              redeemBtn.textContent =
                'Verify Location & Redeem';


              return;

            }


            /*
              Successful redemption.
            */

            showLocationStatus(
              data.message ||
              'Reward redeemed successfully!',
              'success'
            );


            redeemBtn.disabled =
              true;


            redeemBtn.textContent =
              '✓ Reward Redeemed';


            /*
              Reload so the server-rendered
              status becomes REDEEMED.
            */

            setTimeout(
              function () {

                window.location.reload();

              },
              1500
            );


          } catch (error) {


            console.error(
              error
            );


            showLocationStatus(
              'Server error while redeeming reward.',
              'error'
            );


            redeemBtn.disabled =
              false;


            redeemBtn.textContent =
              'Verify Location & Redeem';

          }

        },


        function (error) {


          redeemBtn.disabled =
            false;


          redeemBtn.textContent =
            'Verify Location & Redeem';


          if (
            error.code === 1
          ) {

            showLocationStatus(
              'Please allow location access to redeem your reward.',
              'error'
            );

          } else if (
            error.code === 2
          ) {

            showLocationStatus(
              'Your location could not be detected. Please try again.',
              'error'
            );

          } else if (
            error.code === 3
          ) {

            showLocationStatus(
              'Location request timed out. Please try again.',
              'error'
            );

          } else {

            showLocationStatus(
              'Unable to verify your location.',
              'error'
            );

          }

        },


        {

          enableHighAccuracy:
            true,

          timeout:
            10000,

          maximumAge:
            0

        }

      );

    }


    /* =======================================================
       LOCATION STATUS
    ======================================================== */

    function showLocationStatus(
      message,
      type
    ) {


      if (!locationStatus) {

        return;

      }


      locationStatus.textContent =
        message;


      locationStatus.className =
        'show ' + type;

    }

  </script>


</body>

</html>