<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Admin Dashboard — Adoraise Rewards
  </title>

  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        sans-serif;
    }

    body {
      background: #f3f4f6;
      color: #111827;
      padding: 24px;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 24px;
    }

    .header h2 {
      font-size: 24px;
    }

    .card {
      background: white;
      padding: 24px;
      border-radius: 14px;
      box-shadow:
        0 1px 4px rgba(0,0,0,.08);
      margin-bottom: 24px;
    }

    .grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fit,minmax(200px,1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .stat-card {
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow:
        0 1px 4px rgba(0,0,0,.08);
      border-left: 4px solid #4f46e5;
    }

    .stat-val {
      font-size: 28px;
      font-weight: 800;
      margin-top: 4px;
    }

    .stat-lbl {
      font-size: 13px;
      color: #6b7280;
      font-weight: 600;
      text-transform: uppercase;
    }

    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 6px;
      color: #374151;
    }

    input[type="text"],
    input[type="number"],
    input[type="file"],
    select {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 14px;
      background: white;
    }

    input[type="file"] {
      padding: 9px;
    }

    .flex-row {
      display: flex;
      gap: 16px;
    }

    .flex-row > div {
      flex: 1;
    }

    .btn-save {
      background: #4f46e5;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      font-size: 15px;
    }

    .btn-save:hover {
      background: #4338ca;
    }

    .btn-copy {
      background: #eff6ff;
      color: #2563eb;
      border: 1px solid #bfdbfe;
      padding: 6px 12px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      font-size: 12px;
    }

    .btn-paid {
      background: #10b981;
      color: white;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
      font-size: 13px;
    }

    .btn-paid:hover {
      background: #059669;
    }

    .qr-link {
      background: #10b981;
      color: white;
      padding: 10px 16px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      font-size: 14px;
      white-space: nowrap;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      background: #f8fafc;
      padding: 12px;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      border-bottom: 1px solid #e2e8f0;
    }

    td {
      padding: 14px 12px;
      font-size: 14px;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
    }

    .empty-row {
      text-align: center;
      color: #94a3b8;
      padding: 24px;
    }

    .badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: bold;
      display: inline-block;
    }

    .badge-pending {
      background: #fef3c7;
      color: #b45309;
    }

    .badge-paid {
      background: #d1fae5;
      color: #047857;
    }

    .badge-active {
      background: #dcfce7;
      color: #166534;
    }

    .badge-inactive {
      background: #f3f4f6;
      color: #4b5563;
    }

    .alert {
      padding: 12px 16px;
      background: #d1fae5;
      color: #065f46;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
    }

    .ads-grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fill,minmax(240px,1fr));
      gap: 18px;
    }

    .ad-card {
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      overflow: hidden;
      background: #fff;
    }

    .ad-image {
      width: 100%;
      aspect-ratio: 16 / 7;
      object-fit: cover;
      display: block;
      background: #f3f4f6;
    }

    .ad-content {
      padding: 15px;
    }

    .ad-title {
      font-size: 16px;
      font-weight: 800;
      margin-bottom: 7px;
    }

    .ad-link-text {
      font-size: 12px;
      color: #6b7280;
      word-break: break-all;
      margin-bottom: 12px;
    }

    .ad-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn-toggle {
      border: 0;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 700;
    }

    .btn-toggle.active {
      background: #dcfce7;
      color: #166534;
    }

    .btn-toggle.inactive {
      background: #f3f4f6;
      color: #4b5563;
    }

    .btn-delete {
      border: 0;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 700;
      background: #fee2e2;
      color: #991b1b;
    }

    .upload-note {
      color: #6b7280;
      font-size: 13px;
      margin-top: 6px;
      line-height: 1.5;
    }

    @media (max-width: 700px) {

      body {
        padding: 12px;
      }

      .card {
        padding: 17px;
      }

      .header {
        align-items: flex-start;
        flex-direction: column;
      }

      .header h2 {
        font-size: 21px;
      }

      .qr-link {
        width: 100%;
        text-align: center;
      }

      .flex-row {
        flex-direction: column;
        gap: 0;
      }

      th,
      td {
        white-space: nowrap;
      }

    }

  </style>

</head>


<body>

<div class="container">


  <div class="header">

    <h2>
      Restaurant Admin Dashboard
    </h2>

    <a
      href="/restaurant/qr"
      target="_blank"
      class="qr-link"
    >
      View Restaurant QR Code 🔗
    </a>

  </div>


  <% if (typeof message !== 'undefined' && message) { %>

    <div class="alert">
      <%= message %>
    </div>

  <% } %>


  <!-- STATS -->

  <div class="grid">

    <div class="stat-card">

      <div class="stat-lbl">
        Today's Players
      </div>

      <div class="stat-val">
        <%= stats.totalDevicesToday || 0 %>
      </div>

    </div>


    <div
      class="stat-card"
      style="border-color:#3b82f6;"
    >

      <div class="stat-lbl">
        Active Rewards
      </div>

      <div class="stat-val">
        <%= stats.activeRewards || 0 %>
      </div>

    </div>


    <div
      class="stat-card"
      style="border-color:#f59e0b;"
    >

      <div class="stat-lbl">
        Pending Payouts
      </div>

      <div
        class="stat-val"
        style="color:#f59e0b;"
      >
        <%= stats.pendingPayoutsCount ||
        (pendingPayouts ?
        pendingPayouts.length : 0) %>
      </div>

    </div>


    <div
      class="stat-card"
      style="border-color:#10b981;"
    >

      <div class="stat-lbl">
        Completed Payouts
      </div>

      <div
        class="stat-val"
        style="color:#059669;"
      >
        <%= stats.completedPayoutsCount ||
        (completedPayouts ?
        completedPayouts.length : 0) %>
      </div>

    </div>

  </div>


  <!-- AD UPLOAD -->

  <div class="card">

    <h3 style="margin-bottom:8px;">
      📢 Advertisement Management
    </h3>

    <p
      class="upload-note"
      style="margin-bottom:20px;"
    >
      Upload advertisements that will
      automatically appear as a carousel
      on customer-facing pages.
    </p>


    <form
      action="/admin/ads"
      method="POST"
      enctype="multipart/form-data"
    >

      <div class="form-group">

        <label>
          Advertisement Image
        </label>

        <input
          type="file"
          name="image"
          accept="image/jpeg,image/png,image/webp"
          required
        >

        <p class="upload-note">
          JPG, PNG, JPEG or WEBP.
          Maximum size: 5MB.
        </p>

      </div>


      <div class="form-group">

        <label>
          Advertisement Title
        </label>

        <input
          type="text"
          name="title"
          placeholder="Example: Weekend Special"
          required
        >

      </div>


      <div class="form-group">

        <label>
          Advertisement Link
          <span
            style="
              font-weight:400;
              color:#9ca3af;
            "
          >
            (Optional)
          </span>
        </label>

        <input
          type="text"
          name="link"
          placeholder="https://example.com"
        >

      </div>


      <button
        type="submit"
        class="btn-save"
      >
        Upload Advertisement 📤
      </button>

    </form>

  </div>


  <!-- AD LIST -->

  <div class="card">

    <h3 style="margin-bottom:18px;">
      📋 Uploaded Advertisements
    </h3>


    <% if (!ads || ads.length === 0) { %>

      <div class="empty-row">
        No advertisements uploaded yet.
      </div>

    <% } else { %>


      <div class="ads-grid">

        <% ads.forEach(ad => { %>

          <div class="ad-card">

            <img
              class="ad-image"
              src="<%= ad.imageUrl %>"
              alt="<%= ad.title %>"
            >


            <div class="ad-content">

              <div class="ad-title">
                <%= ad.title %>
              </div>


              <% if (ad.link) { %>

                <div class="ad-link-text">
                  <%= ad.link %>
                </div>

              <% } else { %>

                <div
                  class="ad-link-text"
                >
                  No click link
                </div>

              <% } %>


              <div class="ad-actions">

                <button
                  type="button"
                  class="btn-toggle <%= ad.isActive ? 'active' : 'inactive' %>"
                  onclick="toggleAd('<%= ad._id %>')"
                >
                  <%= ad.isActive
                    ? '🟢 Active'
                    : '⚪ Inactive'
                  %>
                </button>


                <form
                  action="/admin/ads/<%= ad._id %>/delete"
                  method="POST"
                  onsubmit="
                    return confirm(
                      'Delete this advertisement?'
                    )
                  "
                >

                  <button
                    type="submit"
                    class="btn-delete"
                  >
                    🗑 Delete
                  </button>

                </form>

              </div>

            </div>

          </div>

        <% }) %>

      </div>


    <% } %>

  </div>


  <!-- PENDING PAYOUTS -->

  <div class="card">

    <h3
      style="
        margin-bottom:16px;
        color:#b45309;
      "
    >
      ⏳ Pending Cashback Payouts
    </h3>

    <p
      style="
        font-size:13px;
        color:#6b7280;
        margin-bottom:16px;
      "
    >
      Pay customer via GPay/PhonePe using
      their UPI ID and click
      "Mark as Paid".
    </p>


    <div style="overflow-x:auto;">

      <table>

        <thead>

          <tr>

            <th>
              Ticket ID
            </th>

            <th>
              Customer Name
            </th>

            <th>
              UPI ID / Mobile
            </th>

            <th>
              Submitted Time
            </th>

            <th>
              Status
            </th>

            <th>
              Action
            </th>

          </tr>

        </thead>


        <tbody>

          <% if (
            typeof pendingPayouts === 'undefined' ||
            pendingPayouts.length === 0
          ) { %>

            <tr>

              <td
                colspan="6"
                class="empty-row"
              >
                🎉 No pending payouts!
              </td>

            </tr>

          <% } else { %>


            <% pendingPayouts.forEach(item => { %>

              <tr>

                <td>
                  <strong>
                    <%= item.rewardId %>
                  </strong>
                </td>

                <td>
                  <strong>
                    <%= item.customerName || 'N/A' %>
                  </strong>
                </td>

                <td>

                  <span
                    style="
                      font-weight:700;
                      color:#1d4ed8;
                      margin-right:8px;
                    "
                  >
                    <%= item.upiId %>
                  </span>

                  <button
                    class="btn-copy"
                    onclick="
                      copyUpi(
                        '<%= item.upiId %>'
                      )
                    "
                  >
                    📋 Copy
                  </button>

                </td>

                <td>
                  <%= item.payoutSubmittedAt
                    ? new Date(
                        item.payoutSubmittedAt
                      ).toLocaleString()
                    : 'N/A'
                  %>
                </td>

                <td>

                  <span
                    class="badge badge-pending"
                  >
                    PENDING
                  </span>

                </td>

                <td>

                  <button
                    class="btn-paid"
                    onclick="
                      markPaid(
                        '<%= item.rewardId %>'
                      )
                    "
                  >
                    Mark as Paid ✅
                  </button>

                </td>

              </tr>

            <% }) %>


          <% } %>

        </tbody>

      </table>

    </div>

  </div>


  <!-- COMPLETED PAYOUTS -->

  <div class="card">

    <h3
      style="
        margin-bottom:16px;
        color:#059669;
      "
    >
      ✅ Completed Payouts Log
    </h3>


    <div style="overflow-x:auto;">

      <table>

        <thead>

          <tr>

            <th>
              Ticket ID
            </th>

            <th>
              Customer Name
            </th>

            <th>
              UPI ID
            </th>

            <th>
              Paid Time
            </th>

            <th>
              Status
            </th>

          </tr>

        </thead>


        <tbody>

          <% if (
            typeof completedPayouts === 'undefined' ||
            completedPayouts.length === 0
          ) { %>

            <tr>

              <td
                colspan="5"
                class="empty-row"
              >
                No completed payouts recorded yet.
              </td>

            </tr>

          <% } else { %>


            <% completedPayouts.forEach(item => { %>

              <tr>

                <td>
                  <%= item.rewardId %>
                </td>

                <td>
                  <%= item.customerName %>
                </td>

                <td>
                  <%= item.upiId %>
                </td>

                <td>
                  <%= item.paidAt
                    ? new Date(
                        item.paidAt
                      ).toLocaleString()
                    : 'N/A'
                  %>
                </td>

                <td>

                  <span
                    class="badge badge-paid"
                  >
                    PAID
                  </span>

                </td>

              </tr>

            <% }) %>


          <% } %>

        </tbody>

      </table>

    </div>

  </div>


  <!-- SETTINGS -->

  <div class="card">

    <h3 style="margin-bottom:20px;">
      Reward & Geofence Settings
    </h3>


    <form
      id="settingsForm"
      onsubmit="handleSettingsSave(event)"
    >

      <div
        class="form-group"
        style="
          display:flex;
          align-items:center;
          gap:10px;
        "
      >

        <input
          type="checkbox"
          id="rewardEnabled"
          name="rewardEnabled"
          value="true"
          <%= settings.rewardEnabled
            ? 'checked'
            : '' %>
          style="
            width:18px;
            height:18px;
          "
        >

        <label
          for="rewardEnabled"
          style="
            margin:0;
            font-size:16px;
          "
        >
          Enable Reward Claiming
        </label>

      </div>


      <div class="flex-row">

        <div class="form-group">

          <label>
            Restaurant Name
          </label>

          <input
            type="text"
            name="name"
            value="<%= settings.name || '' %>"
            required
          >

        </div>


        <div class="form-group">

          <label>
            Phone Number
          </label>

          <input
            type="text"
            name="phone"
            value="<%= settings.phone || '' %>"
            required
          >

        </div>

      </div>


      <div class="form-group">

        <label>
          Address Description
        </label>

        <input
          type="text"
          name="address"
          value="<%= settings.address || '' %>"
          required
        >

      </div>


      <div class="flex-row">

        <div class="form-group">

          <label>
            Reward Type
          </label>

          <select name="rewardType">

            <option
              value="DISCOUNT_AMOUNT"
              <%= settings.rewardType ===
                'DISCOUNT_AMOUNT'
                ? 'selected'
                : '' %>
            >
              Discount Amount
            </option>

            <option
              value="DISCOUNT_PERCENTAGE"
              <%= settings.rewardType ===
                'DISCOUNT_PERCENTAGE'
                ? 'selected'
                : '' %>
            >
              Discount Percentage
            </option>

            <option
              value="FREE_ITEM"
              <%= settings.rewardType ===
                'FREE_ITEM'
                ? 'selected'
                : '' %>
            >
              Free Item
            </option>

          </select>

        </div>


        <div class="form-group">

          <label>
            Reward Display Value
          </label>

          <input
            type="text"
            name="rewardValue"
            value="<%= settings.rewardValue || '₹100 Cashback' %>"
            required
            placeholder="₹100 Cashback"
          >

        </div>


        <div class="form-group">

          <label>
            Expiry Time (Hours)
          </label>

          <input
            type="number"
            name="rewardExpiryHours"
            value="<%= settings.rewardExpiryHours || 24 %>"
            required
            min="1"
          >

        </div>

      </div>


      <h4
        style="
          margin:20px 0 12px;
        "
      >
        Geofence Settings
      </h4>


      <div class="flex-row">

        <div class="form-group">

          <label>
            Latitude
          </label>

          <input
            type="text"
            name="latitude"
            value="<%= settings.latitude || '' %>"
            required
          >

        </div>


        <div class="form-group">

          <label>
            Longitude
          </label>

          <input
            type="text"
            name="longitude"
            value="<%= settings.longitude || '' %>"
            required
          >

        </div>


        <div class="form-group">

          <label>
            Allowed Radius (Meters)
          </label>

          <input
            type="number"
            name="redemptionRadius"
            value="<%= settings.redemptionRadius || 100 %>"
            required
            min="1"
          >

        </div>

      </div>


      <button
        type="submit"
        class="btn-save"
      >
        Save Settings
      </button>

    </form>

  </div>


</div>


<script>

async function handleSettingsSave(event) {

  event.preventDefault();

  const form =
    event.target;

  const formData =
    new FormData(form);

  const payload = {};

  formData.forEach(
    (value, key) => {
      payload[key] = value;
    }
  );

  payload.rewardEnabled =
    document
      .getElementById(
        'rewardEnabled'
      )
      .checked;


  try {

    const response =
      await fetch(
        '/admin/settings',
        {
          method: 'POST',

          headers: {
            'Content-Type':
              'application/json',

            'Accept':
              'application/json'
          },

          body:
            JSON.stringify(payload)
        }
      );


    const data =
      await response.json();


    if (data.success) {

      alert(
        '✅ ' + data.message
      );

      window.location.reload();

    } else {

      alert(
        '❌ ' +
        (
          data.message ||
          'Unable to save settings.'
        )
      );

    }

  } catch (error) {

    console.error(
      'Save settings error:',
      error
    );

    alert(
      'Server error saving settings.'
    );

  }

}


async function toggleAd(adId) {

  try {

    const response =
      await fetch(
        `/admin/ads/${adId}/toggle`,
        {
          method: 'POST',

          headers: {
            'Accept':
              'application/json'
          }
        }
      );


    const data =
      await response.json();


    if (!data.success) {

      alert(
        data.message ||
        'Unable to update advertisement.'
      );

      return;
    }


    window.location.reload();

  } catch (error) {

    console.error(
      'Toggle advertisement error:',
      error
    );

    alert(
      'Server error updating advertisement.'
    );

  }

}


function copyUpi(upiText) {

  if (
    navigator.clipboard &&
    navigator.clipboard.writeText
  ) {

    navigator.clipboard
      .writeText(upiText)
      .then(() => {

        alert(
          'Copied UPI ID: ' +
          upiText
        );

      })
      .catch(() => {

        alert(
          'Failed to copy UPI ID.'
        );

      });

    return;
  }

  alert(
    'Clipboard is not available in this browser.'
  );

}


async function markPaid(rewardId) {

  if (
    !confirm(
      `Confirm payout complete for Ticket ${rewardId}?`
    )
  ) {
    return;
  }


  try {

    const response =
      await fetch(
        '/admin/payouts/mark-paid',
        {
          method: 'POST',

          headers: {
            'Content-Type':
              'application/json',

            'Accept':
              'application/json'
          },

          body:
            JSON.stringify({
              rewardId
            })
        }
      );


    const data =
      await response.json();


    if (data.success) {

      alert(
        data.message
      );

      window.location.reload();

    } else {

      alert(
        'Error: ' +
        (
          data.message ||
          'Unable to mark payout as paid.'
        )
      );

    }

  } catch (error) {

    console.error(
      'Error marking paid:',
      error
    );

    alert(
      'Server error executing request.'
    );

  }

}

</script>

</body>
</html>